        <mxCell id="4_nwoVnI0Fmn-A8giCIE-116" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.annotation_2;align=left;labelPosition=right;pointerEvents=1;fontColor=light-dark(#f90606, #ededed);direction=east;" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(249, 6, 6), rgb(237, 237, 237));&quot;&gt;не распечатывается документ&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(249, 6, 6), rgb(237, 237, 237));&quot;&gt;для подтверждение от гостя,&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;что услуга оказана. При выселении гость&amp;nbsp;&lt;/div&gt;&lt;div&gt;может потребовать вернуть деньги.&lt;/div&gt;" vertex="1">
